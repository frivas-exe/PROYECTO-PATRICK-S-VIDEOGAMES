digraph G { rankdir=LR; node [shape=record, fontsize=10]; Regla [label="{ReglaNegocio (ABC)|+ aplicar(inventario)}"]; AS [label="{AlertaStock|+ aplicar(inventario)}"]; ASC [label="{AlertaStockCritico|+ aplicar(inventario)}"]; Producto [label="{Producto|- __codigo\l- __nombre\l- __categoria\l- __precio\l- __stock\l- __stock_minimo\l|+ validar_codigo()\l+ desde_fila_csv()\l+ descontar_stock()\l+ reabastecer()\l+ necesita_reabastecer()\l}"]; Venta [label="{Venta (frozen)|fecha\lcodigo\lnombre\lcantidad\lprecio_unitario\ltotal\l|+ crear()\l}"]; Inventario [label="{Inventario|- __productos\l|+ agregar()\l+ obtener()\l+ buscar()\l+ vender()\l+ reabastecer()\l+ ordenar_por_nombre()\l+ ordenar_por_precio()\l+ ordenar_por_stock()\l+ productos_bajos()\l}"]; Repo [label="{RepositorioCSV|+ cargar_inventario()\l+ guardar_inventario()\l+ guardar_venta()\l+ cargar_ventas()\l}"]; Bit [label="{Bitacora|+ registrar()\l}"]; Rep [label="{ReporteVentas|+ ventas_del_dia()\l+ mostrar()\l}"]; App [label="{SistemaInventario|+ ejecutar()\l}"]; Regla -> AS [arrowhead=empty]; Regla -> ASC [arrowhead=empty]; Inventario -> Producto [label="contiene"]; Inventario -> Venta [label="crea", style=dashed]; App -> Inventario [label="usa"]; App -> Repo [label="usa"]; App -> Bit [label="usa"]; App -> Rep [label="usa"]; App -> Regla [label="polimorfismo", style=dashed]; Repo -> Producto [style=dashed]; Repo -> Venta [style=dashed]; Rep -> Repo [style=dashed]; }
